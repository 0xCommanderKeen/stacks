{
  "name": "stacks-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write src tests *.js *.ts *.json",
    "lint": "prettier --check src tests *.js *.ts *.json",
    "types": "openapi-typescript ../openapi.json -o src/lib/schema.d.ts && prettier --write src/lib/schema.d.ts",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.40.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.40.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0"
  }
}
